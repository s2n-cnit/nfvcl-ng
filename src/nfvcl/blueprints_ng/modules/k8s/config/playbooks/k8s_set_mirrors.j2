---
- hosts: all
  become: yes
  gather_facts: no
  tasks:
    - name: Create /etc/containerd/certs.d directory
      file:
        path: /etc/containerd/certs.d
        state: directory
        mode: '0755'

    - name: Set containerd registry config_path
      replace:
        path: /etc/containerd/config.toml
        after: "\\[plugins\\.'io\\.containerd\\.cri\\.v1\\.images'\\.registry\\]"
        before: "\\[plugins\\.'io\\.containerd\\.cri\\.v1\\.images'\\.image_decryption\\]"
        regexp: "config_path = ''"
        replace: 'config_path = "/etc/containerd/certs.d"'

{% for key, value in confvar.k8s_mirrors.items() %}
    - name: Create mirror directory for {{ key }}
      file:
        path: /etc/containerd/certs.d/{{ key }}
        state: directory
        mode: '0755'

    - name: Create hosts.toml for {{ key }}
      copy:
        dest: /etc/containerd/certs.d/{{ key }}/hosts.toml
        content: |
          server = "{% if key == 'docker.io' %}https://registry-1.docker.io{% else %}https://{{ key }}{% endif %}"

          [host."{{ value }}"]
            capabilities = ["pull", "resolve"]
            override_path = true
{% endfor %}
